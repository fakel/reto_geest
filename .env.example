# PostgreSQL connection string (required by Prisma Migrate & Prisma Client)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reto_geest"

# SQS queues (required by the API)
NOTIFICATION_QUEUE_URL=""
DLQ_URL=""

# Webhook target (required by the Worker)
NOTIFY_URL=""

# Optional, with defaults
IDEMPOTENCY_TTL_SECONDS=86400
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
NODE_ENV=development
